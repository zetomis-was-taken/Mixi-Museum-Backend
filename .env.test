NODE_ENV=test

# Dedicated database for migration tests, created by docker/init-test-db.sql.
DATABASE_URL=postgres://museum:museum@localhost:5432/museum_test

# Origins allowed to call the API from a browser during tests.
CORS_ORIGINS=http://localhost:5173

# JWT authentication settings
JWT_SECRET=test-jwt-secret-key-at-least-32-characters!
JWT_EXPIRES_IN=1h
