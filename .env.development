NODE_ENV=development
PORT=3000

# PostgreSQL connection string, e.g. postgres://user:password@localhost:5432/mydb
# Matches the credentials in docker-compose.yml.
DATABASE_URL=postgres://museum:museum@localhost:5432/museum

# Comma-separated list of browser origins allowed to call the API.
# Add your frontend URL (e.g. the Vite/Next dev server) as needed.
CORS_ORIGINS=http://localhost:5173

# JWT authentication settings
JWT_SECRET=super-secret-development-jwt-key-32chars!
JWT_EXPIRES_IN=7d
